{
  "name": "@macuxierp/conector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.7" },
  "description": "Conector on-premise do Macuxi ERP: lê o banco do cliente e empurra os cadastros à /entrada/v1 do ERP por delta (ADR 0014 §6; base FDV 1.5.0 @c460e92).",
  "scripts": {
    "start": "tsx src/cli.ts",
