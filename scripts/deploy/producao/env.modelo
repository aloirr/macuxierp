# Arquivos de ambiente da produção do Macuxi ERP (T-0024, ADR 0003): LISTA ÚNICA. Só nomes, nenhum valor.
#   - ficam na VM do FDV, em /opt/macuxierp, modo 600, dono o usuário de deploy (nada em /opt/macuxi, do FDV);
#   - quem grava cada arquivo está no cabeçalho do bloco. Nenhum valor vai para o git, recado, chat ou log;
#   - os nomes são os que o código lê (apps/api/src/config.ts, apps/worker/src/main.ts, apps/web) e os que o
#     producao-publicar.yml grava; o compose.yml os entrega a cada serviço.

# ---------- /opt/macuxierp/.env — criado pelo Alexandre na VM (chmod 600 /opt/macuxierp/.env) ----------
# Chave mestra que cifra o certificado A1 e a senha dele no banco (modules/core/api/cifra.ts). OBRIGATÓRIA: sem ela o
# implantar.sh não publica. 32 bytes, em base64 (44 caracteres) ou hex (64). Gerar NA VM: openssl rand -base64 32
# Nunca colar em chat, recado, issue ou commit. Nunca trocar depois do primeiro A1 cadastrado: os A1 cifrados deixam de abrir.
MACUXIERP_CHAVE_A1=
# Nome do banco no DBaaS do FDV (opcional; padrão macuxierp). O compose o entrega como PGDATABASE.
MACUXIERP_BANCO=
# Object Storage do FDV, prefixo macuxierp/<tenant>/ (ADR 0003, item 7); as chaves de acesso vêm do segredos.env.
# Contrato para o core e o faturamento: o código ainda não lê.
MACUXIERP_S3_ENDPOINT=
MACUXIERP_S3_REGIAO=
MACUXIERP_S3_BUCKET=
# Rede Docker do túnel da Cloudflare do FDV (opcional; padrão no comum.sh: macuxi-prod_macuxi)
MACUXIERP_REDE_TUNEL=
# Chave mestra que cifra as credenciais do Conector do Hub do FDV no banco (apps/worker/src/credencial.ts). Opcional no
# 1º deploy: vazia = laço de agenda do worker desligado (nada sai para o Hub). Usada pelo worker e, em breve, pela api
# (plugin do integracao-fdv, R-013902). 32 bytes, em hex (64) ou base64 (44). Gerar NA VM: openssl rand -hex 32
# Presente e inválida, o implantar.sh não publica. Separada da MACUXIERP_CHAVE_A1 (nunca reaproveitar).
# Nunca colar em chat, recado, issue ou commit. Nunca trocar depois de gravar a credencial do Conector: ela deixa de abrir.
MACUXIERP_CHAVE_INTEGRACAO=
# URL base do Hub do FDV em produção (https://.../integracao/v1, sem usuário, senha nem consulta). Só o worker.
# DEIXAR VAZIA por ora: o worker exige as URLs de teste e de produção juntas (apps/worker/src/hub.ts) e a de teste não
# entra em produção; preenchida sozinha, o worker não sobe. O implantar.sh recusa o valor até o PR que ajustar o hub.ts.
MACUXIERP_HUB_URL_PRODUCAO=

# ---------- /opt/macuxierp/gerados.env — preparar-vm.sh (openssl rand; nunca sai da VM, nunca é regenerado) ----------
# senhas dos papéis macuxierp_app (api), macuxierp_worker (worker) e macuxierp_leitura; o banco.sh aplica a cada deploy
MACUXIERP_SENHA_APP=
MACUXIERP_SENHA_WORKER=
MACUXIERP_SENHA_LEITURA=
# segredo do JWT da API (só a api recebe)
MACUXIERP_JWT_SEGREDO=

# ---------- /opt/macuxierp/banco.env — producao-publicar.yml (secrets PROD_PG_HOST e PROD_PG_PORTA, padrão 5432) ----------
# o mesmo DBaaS do FDV; o compose entrega à api e ao worker como PGHOST/PGPORT
MACUXI_PG_HOST=
MACUXI_PG_PORTA=

# ---------- /opt/macuxierp/admin.env — producao-publicar.yml (secrets PROD_PG_ADMIN_USUARIO e PROD_PG_ADMIN_SENHA) ----------
# admin do DBaaS: CREATEDB e CREATEROLE, NOSUPERUSER. Só as ferramentas migrar, psql e papeis leem; api, worker e web nunca.
MACUXI_PG_ADMIN_USUARIO=
MACUXI_PG_ADMIN_SENHA=

# ---------- /opt/macuxierp/segredos.env — producao-publicar.yml (secrets PROD_S3_KEY_ID e PROD_S3_SECRET) ----------
# chave do Object Storage com acesso ao prefixo macuxierp/; só a api e o worker. O código ainda não lê.
MACUXI_S3_CHAVE_ID=
MACUXI_S3_SEGREDO=

# ---------- /opt/macuxierp/email.env — producao-publicar.yml (secrets PROD_SMTP_*; sem PROD_SMTP_HOST, vazio) ----------
# e-mail transacional, só a api e o worker; vazio = e-mail desligado. Contrato para o core: o código ainda não lê.
MACUXI_SMTP_HOST=
MACUXI_SMTP_PORTA=
MACUXI_SMTP_TLS=
MACUXI_SMTP_USUARIO=
MACUXI_SMTP_SENHA=
MACUXI_SMTP_REMETENTE=

# ---------- /opt/macuxierp/alerta.env — producao-publicar.yml, só se o secret PROD_ALERTA_WEBHOOK existir ----------
# lido só pelo alerta-saude.sh no host
MACUXI_ALERTA_WEBHOOK=

# ---------- /opt/macuxierp/certs/dbaas-ca.pem — producao-publicar.yml, só se o secret PROD_PG_CA_CERT existir ----------
# PEM da CA do DBaaS (opcional). Com ele o TLS vira verify-full.

# ---------- fixados no compose.yml / gravados pelo implantar.sh — NÃO vão no .env ----------
# compose.yml:
#   MACUXIERP_HOST=0.0.0.0                          (api)
#   MACUXIERP_PORTA=8100                            (api; no host, só 127.0.0.1:8200)
#   MACUXIERP_COOKIE_SEGURO=1                       (api)
#   MACUXIERP_PG_POOL=10 (api) e 5 (worker)
#   MACUXIERP_WORKER_INTERVALO_MS=1000              (worker)
#   MACUXIERP_FDV_RECEBIMENTO=desligado             (worker; trava do Alexandre: nenhuma escrita no Hub real; só por PR)
#   MACUXIERP_FDV_ENVIO=desligado                   (worker; mesma trava: sem lotes, sinal nem reconciliação; só por PR)
#   (MACUXIERP_HUB_URL_TESTE não entra em produção)
#   MACUXIERP_API_URL=http://macuxierp-api:8100     (web)
#   MACUXIERP_ARQUIVOS_PREFIXO=macuxierp/           (api e worker; o código ainda não lê)
#   PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE: montados a partir dos arquivos acima
# /opt/macuxierp/imagens.env, gravado pelo implantar.sh a cada publicação (não é segredo):
#   MACUXIERP_VERSAO=<tag v* publicada>             (api e worker; o /v1/saude devolve)
#   MACUXIERP_IMAGEM_API, MACUXIERP_IMAGEM_WEB      (por digest, @sha256:...)
#   MACUXIERP_PG_SSL_NODE, MACUXIERP_PG_SSL_LIBPQ   (TLS do banco: verify-full com a CA, senão no-verify/require)
