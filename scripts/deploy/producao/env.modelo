# Arquivos de ambiente da produção do Macuxi ERP (T-0024, ADR 0003): LISTA ÚNICA. Só nomes, nenhum valor.
#   - ficam na VM do FDV, em /opt/macuxierp, modo 600, dono o usuário de deploy (nada em /opt/macuxi, do FDV);
#   - quem grava cada arquivo está no cabeçalho do bloco. Nenhum valor vai para o git, recado, chat ou log;
#   - os nomes são os que o código lê (apps/api/src/config.ts, apps/worker/src/main.ts, apps/web); o compose.yml os
#     entrega a cada serviço.
# Deploy AUTOMATIZADO (R-20261122-021030): o producao-publicar.yml só usa PROD_SSH_KEY, PROD_HOST e PROD_USER. Todos os
# arquivos abaixo são gravados na VM pelo preparar-vm.sh (ambiente-vm.sh), a cada publicação, sem passo manual.

# ---------- /opt/macuxierp/.env — preparar-vm.sh (ambiente-vm.sh) cria se faltar ----------
# As duas chaves mestras são geradas NA VM (openssl rand -hex 32) SÓ se faltarem ou estiverem vazias; valor presente
# NUNCA é trocado. As outras variáveis são opcionais e, se preciso, acrescentadas à mão na VM (não são regravadas).
# Chave mestra que cifra o certificado A1 e a senha dele no banco (packages/platform-sdk/src/cifra.ts). OBRIGATÓRIA: sem
# ela o implantar.sh não publica. 32 bytes, em hex (64) ou base64 (44).
# Nunca colar em chat, recado, issue ou commit. Nunca trocar depois do primeiro A1 cadastrado: os A1 cifrados deixam de abrir.
MACUXIERP_CHAVE_A1=
# Nome do banco no DBaaS do FDV (opcional; padrão macuxierp). O compose o entrega como PGDATABASE.
MACUXIERP_BANCO=
# Object Storage do FDV, prefixo macuxierp/<tenant>/ (ADR 0003, item 7); as chaves de acesso vêm do segredos.env.
# Contrato para o core e o faturamento: o código ainda não lê.
MACUXIERP_S3_ENDPOINT=
MACUXIERP_S3_REGIAO=
MACUXIERP_S3_BUCKET=
# Rede Docker do túnel da Cloudflare do FDV (opcional; padrão no comum.sh: macuxi-prod_macuxi)
MACUXIERP_REDE_TUNEL=
# Chave mestra que cifra as credenciais do Conector do Hub do FDV no banco (apps/worker/src/credencial.ts). Gerada pelo
# preparar-vm.sh se faltar. Obrigatória; usada pela api e pelo worker. 32 bytes, em hex (64) ou base64 (44).
# Separada da MACUXIERP_CHAVE_A1 (nunca reaproveitar).
# Nunca colar em chat, recado, issue ou commit. Nunca trocar depois de gravar a credencial do Conector: ela deixa de abrir.
MACUXIERP_CHAVE_INTEGRACAO=

# ---------- /opt/macuxierp/gerados.env — preparar-vm.sh (ambiente-vm.sh; openssl rand; nunca sai da VM, nunca é regenerado) ----------
# senhas dos papéis macuxierp_app (api), macuxierp_worker (worker) e macuxierp_leitura; o banco.sh aplica a cada deploy
MACUXIERP_SENHA_APP=
MACUXIERP_SENHA_WORKER=
MACUXIERP_SENHA_LEITURA=
# segredo do JWT da API (só a api recebe)
MACUXIERP_JWT_SEGREDO=

# ---------- copiados da produção do FDV na mesma VM (/opt/macuxi, SÓ LEITURA) ----------
# preparar-vm.sh (ambiente-vm.sh), a cada publicação: só as variáveis com estes nomes (nada a mais do FDV), 600. Arquivo
# do FDV ausente = a publicação falha citando o caminho. O banco, os papéis e o prefixo do S3 continuam próprios do ERP.

# ---------- /opt/macuxierp/banco.env — cópia de /opt/macuxi/banco.env (MACUXI_PG_HOST obrigatória; porta padrão 5432) ----------
# o mesmo DBaaS do FDV; o compose entrega à api e ao worker como PGHOST/PGPORT
MACUXI_PG_HOST=
MACUXI_PG_PORTA=

# ---------- /opt/macuxierp/admin.env — cópia de /opt/macuxi/admin.env (as duas obrigatórias) ----------
# admin do DBaaS: CREATEDB e CREATEROLE, NOSUPERUSER. Só as ferramentas migrar, psql e papeis leem; api, worker e web nunca.
MACUXI_PG_ADMIN_USUARIO=
MACUXI_PG_ADMIN_SENHA=

# ---------- /opt/macuxierp/segredos.env — cópia de /opt/macuxi/segredos.env (o arquivo é exigido; as variáveis, não) ----------
# chave do Object Storage do FDV (o ERP usa o prefixo macuxierp/); só a api e o worker. O código ainda não lê.
MACUXI_S3_CHAVE_ID=
MACUXI_S3_SEGREDO=

# ---------- /opt/macuxierp/certs/dbaas-ca.pem — cópia de /opt/macuxi/certs/dbaas-ca.pem (opcional, 644) ----------
# PEM da CA do DBaaS. Com ele o TLS vira verify-full; sem ele, require/no-verify (aviso no deploy).

# ---------- /opt/macuxierp/email.env — NÃO é gravado (SMTP desligado; o compose aceita a falta: required: false) ----------
# e-mail transacional, só a api e o worker; ausente = e-mail desligado. Contrato para o core: o código ainda não lê.
MACUXI_SMTP_HOST=
MACUXI_SMTP_PORTA=
MACUXI_SMTP_TLS=
MACUXI_SMTP_USUARIO=
MACUXI_SMTP_SENHA=
MACUXI_SMTP_REMETENTE=

# ---------- /opt/macuxierp/alerta.env — NÃO é gravado (webhook desligado; o alerta-saude.sh avisa só no journal) ----------
# lido só pelo alerta-saude.sh no host
MACUXI_ALERTA_WEBHOOK=

# tunel.env e push.env não existem no ERP: o túnel é o do FDV (rede externa no compose.yml) e não há push.

# ---------- fixados no compose.yml / gravados pelo implantar.sh — NÃO vão no .env ----------
# compose.yml:
#   MACUXIERP_HOST=0.0.0.0                          (api)
#   MACUXIERP_PORTA=8100                            (api; no host, só 127.0.0.1:8200)
#   MACUXIERP_COOKIE_SEGURO=1                       (api)
#   MACUXIERP_PG_POOL=10 (api) e 5 (worker)
#   MACUXIERP_WORKER_INTERVALO_MS=1000              (worker)
#   MACUXIERP_FDV_RECEBIMENTO=desligado             (worker; trava de 22/11 mantida na v0.2.0, R-20261122-061838; virada por PR próprio)
#   MACUXIERP_FDV_ENVIO=desligado                   (worker; idem)
#   MACUXIERP_HUB_URL_PRODUCAO=https://api.macuxifdv.com.br/integracao/v1   (worker; idem; no .env é ignorada)
#   MACUXIERP_HUB_URL_TESTE=https://hub-teste.invalid/integracao/v1         (worker; idem)
#   MACUXIERP_API_URL=http://macuxierp-api:8100     (web)
#   MACUXIERP_ARQUIVOS_PREFIXO=macuxierp/           (api e worker; o código ainda não lê)
#   PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE: montados a partir dos arquivos acima
# /opt/macuxierp/imagens.env, gravado pelo implantar.sh a cada publicação (não é segredo):
#   MACUXIERP_VERSAO=<tag v* publicada>             (api e worker; o /v1/saude devolve)
#   MACUXIERP_IMAGEM_API, MACUXIERP_IMAGEM_WEB      (por digest, @sha256:...)
#   MACUXIERP_PG_SSL_NODE, MACUXIERP_PG_SSL_LIBPQ   (TLS do banco: verify-full com a CA, senão no-verify/require)
